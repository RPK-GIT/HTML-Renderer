      "section": "4 · Principles",
      "title": "Three pillars of remote engagement",
      "columns": [
        {
          "heading": "Participation",
          "body": "Every attendee contributes something visible in the first ten minutes.",
          "bullets": ["Round-robin openers", "Shared canvases", "Small breakout groups"]
        },
        {
          "heading": "Rhythm",
          "body": "Alternate intensity: never more than fifteen minutes in one mode.",
          "bullets": ["Timeboxed exercises", "Movement breaks", "Energy checks"]
        },
        {
          "heading": "Clarity",
          "body": "At any moment everyone knows what is being asked of them.",
          "bullets": ["One instruction at a time", "Visible timers", "Written prompts"]
        }
      ],
